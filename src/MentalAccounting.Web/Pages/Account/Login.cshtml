@page
@model MentalAccounting.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Accedi"; }
<div class="max-w-md mt-12 mx-auto">
<p class="eyebrow">IL TUO ACCANTONAMENTO</p><h1>Accedi</h1>
<p class="muted">Saldo, interessi e obiettivi, in un unico posto.</p>
<form method="post" class="panel mt-4">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<label asp-for="Username" class="field-label">Nome utente</label><input asp-for="Username" autocomplete="username" class="field mb-3" />
<label asp-for="Password" class="field-label">Password</label><input asp-for="Password" autocomplete="current-password" class="field mb-4" />
<button class="button button-primary">Accedi</button>
</form></div>
