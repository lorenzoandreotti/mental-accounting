@model MentalAccounting.Web.Pages.ScenarioGrid
<div data-grid data-sort="1:desc" aria-label="Scenari"><div class="table-scroll"><table class="data-table"><thead><tr><th data-type="text">Nome</th><th data-type="date">Data finale</th><th data-type="select">Metodo</th><th data-type="number">Movimenti</th>@if(Model.Actions){<th data-type="none">Azioni</th>}</tr></thead><tbody>
@foreach(var s in Model.Items){<tr><td>@if(Model.Actions){<a asp-page="/Simulations" asp-route-id="@s.Id">@s.Name</a>}else{@s.Name}</td><td data-value="@s.Through.ToString("yyyy-MM-dd")">@s.Through.ToString("dd/MM/yyyy")</td><td>@(s.Method==MentalAccounting.Domain.InterestMethod.Simple?"Semplice":"Composto")</td><td>@s.Ledger.Movements.Count</td>@if(Model.Actions){<td><form method="post" asp-page="/Simulations" asp-page-handler="Delete"><input name="Version" value="@Model.Version" type="hidden"/><input name="id" value="@s.Id" type="hidden"/><button class="button button-small button-danger">Elimina</button></form></td>}</tr>}
</tbody></table></div></div>
