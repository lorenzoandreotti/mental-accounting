<!DOCTYPE html>
<html lang="it">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Accantona</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header class="app-header"><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" asp-page="/Index"><span class="brand-mark">a</span> accantona</a>
@if(User.Identity?.IsAuthenticated==true){<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Apri navigazione"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="navigation"><div class="navbar-nav ms-auto"><a class="nav-link" asp-page="/Index">Panoramica</a><a class="nav-link" asp-page="/Movements">Movimenti</a><a class="nav-link" asp-page="/Interest">Interessi</a><a class="nav-link" asp-page="/Simulations">Simulazioni</a><a class="nav-link" asp-page="/Settings">Condizioni</a><a class="nav-link" asp-page="/Transfer">Dati</a><form method="post" asp-page="/Account/Logout"><button class="btn nav-link">Esci</button></form></div></div>}
</div></nav></header>
<main class="container py-4 py-lg-5">
@if(TempData["Message"] is string message){<div class="alert alert-success" role="status">@message</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
@RenderBody()</main><footer class="container py-4 text-secondary small">Accantona · Il tuo denaro, con una destinazione.</footer><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
