<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] · Accantona</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header class="border-b border-[var(--line)] bg-[var(--surface)]">
    <div class="shell flex flex-wrap items-center justify-between gap-3 py-4">
        <a class="flex items-center gap-2 text-xl font-semibold tracking-tight" asp-page="/Index"><span class="rounded-lg bg-[var(--accent)] px-3 py-1 text-[var(--canvas)]" aria-hidden="true">a</span> accantona</a>
        <div class="flex items-center gap-3">
            <button type="button" class="button button-small" data-theme-toggle aria-label="Passa al tema scuro" aria-pressed="false">Scuro</button>
            @if(User.Identity?.IsAuthenticated==true){<button class="button lg:hidden" type="button" data-nav-toggle aria-controls="navigation" aria-expanded="false">Menu</button>}
        </div>
        @if(User.Identity?.IsAuthenticated==true){
            <nav class="hidden w-full flex-col gap-1 lg:flex lg:flex-row lg:items-center" id="navigation" data-navigation aria-label="Navigazione principale">
                <a class="nav-link" asp-page="/Index">Movimenti</a>
                <a class="nav-link" asp-page="/Interest">Dettaglio interessi</a>
                <a class="nav-link" asp-page="/Simulations">Simulazioni</a>
                <a class="nav-link" asp-page="/Settings/Conditions" data-settings-link>Impostazioni</a>
                <form method="post" asp-page="/Account/Logout" class="lg:ml-auto"><button class="nav-link">Esci</button></form>
            </nav>
        }
    </div>
</header>
<main class="shell py-6 sm:py-8">
    @if(TempData["Message"] is string message){<div class="notice notice-success" role="status">@message</div>}
    @if(TempData["Error"] is string error){<div class="notice text-[var(--danger)]" role="alert">@error</div>}
    @RenderBody()
</main>
<footer class="shell py-6 text-xs muted">Accantona · Il tuo denaro, con una destinazione.</footer>
<script type="module" src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts",required:false)
</body></html>
