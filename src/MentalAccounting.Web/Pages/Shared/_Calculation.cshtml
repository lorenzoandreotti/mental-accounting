@model MentalAccounting.Domain.CalculationResult
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><span>Saldo disponibile</span><strong class="fs-3">@Model.Balance.ToString("C")</strong></div></div><div class="col-md-4"><div class="card card-body"><span>Lordo da accreditare</span><strong class="fs-3">@Model.AccruedGross.ToString("C")</strong></div></div><div class="col-md-4"><div class="card card-body"><span>Netto da accreditare</span><strong class="fs-3">@Model.AccruedNet.ToString("C")</strong></div></div></div>
<section class="card card-body mb-4"><h2>Liquidazioni per periodo</h2><div class="table-responsive"><table class="table"><thead><tr><th>Periodo</th><th>Accredito</th><th>Lordo</th><th>Imposta</th><th>Netto</th><th>Stato</th></tr></thead><tbody>
@foreach(var s in Model.Settlements){<tr><td>@s.From.ToString("dd/MM/yyyy") – @s.Through.ToString("dd/MM/yyyy")</td><td>@s.CreditDate.ToString("dd/MM/yyyy")</td><td>@s.Gross.ToString("C")</td><td>@s.Tax.ToString("C")</td><td>@s.Net.ToString("C")</td><td>@(s.Credited?"Accreditato":"In attesa")</td></tr>}
</tbody></table></div><p class="mb-0 text-secondary">Periodo aperto: lordo @Model.OpenGross.ToString("C"), imposta @Model.OpenTax.ToString("C"). Chiusi in attesa: lordo @Model.PendingGross.ToString("C"), imposta @Model.PendingTax.ToString("C").</p></section>
<section class="card card-body"><h2>Come sono calcolati</h2><p class="text-secondary">Importi di dettaglio a sei decimali; arrotondamento ai centesimi solo alla chiusura.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Dal / al</th><th>Giorni</th><th>Capitale</th><th>Tasso</th><th>Aliquota</th><th>Base</th><th>Lordo</th><th>Imposta</th></tr></thead><tbody>
@foreach(var s in Model.Segments){<tr><td>@s.From.ToString("dd/MM/yyyy")<br/>@s.Through.ToString("dd/MM/yyyy")</td><td>@s.Days</td><td>@s.Capital.ToString("C")</td><td>@s.Rate.ToString("P4")</td><td>@s.TaxRate.ToString("P2")</td><td>@s.Denominator</td><td>@s.Gross.ToString("N6")</td><td>@s.Tax.ToString("N6")</td></tr>}
</tbody></table></div></section>
