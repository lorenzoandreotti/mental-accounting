@model MentalAccounting.Web.Pages.ReviewView
@using MentalAccounting.Web.Pages
@using System.Globalization
@{var ledger=Model.Change.Document.Ledger!;}
<section class="panel space-y-5">
<div><p class="eyebrow">VERIFICA PRIMA DI SALVARE</p><h1 class="text-2xl">Conferma la modifica</h1><p class="muted text-sm">Il calcolo comprende tutti i movimenti fino a oggi. Gli accrediti successivi alle modifiche vengono ricalcolati.</p></div>
<div class="grid gap-4 sm:grid-cols-2"><div><span class="text-sm muted">Saldo precedente</span><strong class="stat">@(Model.Change.Before?.Balance.ToString("C")??"—")</strong></div><div><span class="text-sm muted">Nuovo saldo</span><strong class="stat">@Model.Change.After.Balance.ToString("C")</strong></div></div>
<p>Netto maturato: @(Model.Change.Before?.AccruedNet.ToString("C")??"—") → <strong>@Model.Change.After.AccruedNet.ToString("C")</strong></p>
<dl class="grid gap-2 text-sm sm:grid-cols-2"><dt class="muted">Avvio e saldo iniziale</dt><dd>@ledger.Start.ToString("dd/MM/yyyy") · @ledger.OpeningBalance.ToString("C")</dd><dt class="muted">Periodicità</dt><dd>Ogni @ledger.Calendar.Months mesi · @(ledger.Calendar.Civil?"periodi civili":$"riferimento {ledger.Calendar.Anchor:dd/MM/yyyy}")</dd></dl>
<details><summary class="font-medium">Controlla i dati proposti</summary><div class="space-y-6 mt-4">
<section><h2>Movimenti</h2><div data-grid data-sort="0:desc" aria-label="Anteprima movimenti"><div class="table-scroll"><table class="data-table"><thead><tr><th data-type="date">Data</th><th data-type="select">Tipo</th><th data-type="number">Importo (€)</th><th data-type="text">Nota</th></tr></thead><tbody>
@foreach(var m in ledger.Movements){<tr><td data-value="@m.Date.ToString("yyyy-MM-dd")">@m.Date.ToString("dd/MM/yyyy")</td><td data-value="@m.Kind">@Labels.Movement(m.Kind)</td><td data-value="@m.Amount.ToString(CultureInfo.InvariantCulture)">@m.Amount.ToString("C")</td><td>@m.Note</td></tr>}
</tbody></table></div></div></section>
<section><h2>Tassi annui lordi</h2><partial name="_ConditionTable" model="ledger.Rates.Select(x=>new ConditionInput { From=x.From,Percentage=x.Rate*100 }).ToList()"/></section>
<section><h2>Aliquote sugli interessi</h2><partial name="_ConditionTable" model="ledger.Taxes.Select(x=>new ConditionInput { From=x.From,Percentage=x.Rate*100 }).ToList()"/></section>
<p class="text-sm muted">Base: @Labels.Basis(ledger.Basis). Accredito: @Labels.Timing(ledger.Calendar.Timing), giorno @ledger.Calendar.CreditDay. Maturato iniziale: lordo @ledger.OpeningGross.ToString("C"), imposta @ledger.OpeningTax.ToString("C").</p>
<section><h2>Scenari proposti</h2><partial name="_ScenarioTable" model="new ScenarioGrid(Model.Change.Document.Scenarios)"/></section>
</div></details>
<form method="post" asp-page-handler="Confirm" class="flex flex-wrap gap-2"><input type="hidden" name="Ticket" value="@Model.Ticket"/><button class="button button-primary">Conferma e salva</button><a href="" class="button">Annulla</a></form>
</section>
