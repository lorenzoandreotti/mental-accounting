@page
@model MentalAccounting.Web.Pages.SimulationsModel
@using MentalAccounting.Domain
@using MentalAccounting.Web.Pages
@{ViewData["Title"]="Simulazioni";}
<p class="eyebrow">UNO SGUARDO AVANTI</p><h1>Simulazioni</h1><p class="muted">Prova versamenti e condizioni future. Gli scenari salvati conservano i dati usati al momento del calcolo.</p>
<div asp-validation-summary="All" class="validation" role="alert"></div>
@if(Model.Review is {} review){<partial name="_Review" model="review"/>}else{
<form method="post" class="panel mb-5 space-y-6"><div class="grid gap-4 sm:grid-cols-3">
<div><label asp-for="Name" class="field-label">Nome scenario</label><input asp-for="Name" class="field" maxlength="100"/></div><div><label asp-for="Through" class="field-label">Data finale</label><input asp-for="Through" type="date" class="field"/></div><div><label asp-for="Method" class="field-label">Metodo da analizzare</label><select asp-for="Method" class="field"><option value="Simple">Interesse semplice</option><option value="Compound">Interesse composto equivalente</option></select></div></div>
<p class="text-xs muted">Le ipotesi aggiuntive devono avere date successive a oggi. Le percentuali sono espresse in punti percentuali: 2 significa 2%.</p>
<partial name="_EditorGrid" model='new EditorGrid("FutureMovements","Movimenti ipotetici",Movements:Model.FutureMovements)'/>
<partial name="_EditorGrid" model='new EditorGrid("FutureRates","Nuovi tassi futuri",Model.FutureRates)'/>
<partial name="_EditorGrid" model='new EditorGrid("FutureTaxes","Nuove aliquote future",Model.FutureTaxes)'/>
<button class="button button-primary">Calcola e confronta</button></form>
@if(Model.Result is {} r){<section class="mb-5"><h2>@Model.ResultName</h2><p class="text-sm muted">Metodo: @(Model.Method==InterestMethod.Simple?"semplice":"composto equivalente") · Data finale: @r.AsOf.ToString("dd/MM/yyyy")</p>
@if(Model.Comparison is {} c){<p class="notice">Saldo con il metodo selezionato: <strong>@r.Balance.ToString("C")</strong> · Con il metodo alternativo: <strong>@c.Balance.ToString("C")</strong><br/>Netto non accreditato: @r.AccruedNet.ToString("C") contro @c.AccruedNet.ToString("C").</p>}
@if(!string.IsNullOrEmpty(Model.ScenarioTicket)){<form method="post" asp-page-handler="Save" class="mb-4"><input asp-for="ScenarioTicket" type="hidden"/><button class="button">Salva questo scenario</button></form>}
<partial name="_Calculation" model="r"/></section>}
<section class="panel"><h2>Scenari salvati</h2><partial name="_ScenarioTable" model="new ScenarioGrid(Model.State.Document.Scenarios,true,Model.State.Version)"/></section>
}
