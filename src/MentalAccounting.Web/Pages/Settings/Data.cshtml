@page
@model MentalAccounting.Web.Pages.Settings.DataModel
@{ViewData["Title"]="Importa ed esporta";}
<partial name="_SettingsNavigation"/><p class="eyebrow">I TUOI DATI</p><h1>Importa ed esporta</h1>
<div asp-validation-summary="All" class="validation" role="alert"></div>
@if(Model.Import is {} import){<section class="notice"><h2 class="text-base">Lettura del foglio</h2><p>@import.Movements.Count movimenti riconosciuti.</p>@foreach(var w in import.Warnings){<p>@w</p>}@foreach(var e in import.Errors){<p class="validation">@e</p>}</section>}
@if(Model.Review is {} review){<partial name="_Review" model="review"/>}else{
<section class="panel mb-4"><h2>Recupera il foglio Excel</h2><p>Il foglio <strong>Sheet1</strong> deve avere data in C, tipo in D e importo in E. Carico diventa versamento; Prelievo e Addebito diventano uscite. Interessi e Consolidamento vengono ignorati e ricalcolati.</p><p>La conferma sostituisce tutti i movimenti attuali. Le condizioni e il saldo iniziale restano quelli configurati. Nessuna formula viene eseguita.</p><form method="post" asp-page-handler="Workbook" enctype="multipart/form-data"><input asp-for="Version" type="hidden"/><label for="workbook" class="field-label">File XLSX (massimo 5 MB)</label><input name="Upload" id="workbook" type="file" accept=".xlsx" class="field mb-3" required/><button class="button button-primary">Leggi e verifica</button></form></section>
<section class="panel mb-4"><h2>Esporta</h2><p>Il backup JSON contiene impostazioni, movimenti e scenari. Non contiene credenziali.</p><div class="flex flex-wrap gap-2"><a asp-page-handler="Export" asp-route-format="json" class="button">Backup completo JSON</a><a asp-page-handler="Export" asp-route-format="csv" class="button">Movimenti CSV</a><a asp-page-handler="Export" asp-route-format="settlements" class="button">Liquidazioni CSV</a></div></section>
<section class="panel"><h2>Ripristina un backup</h2><p>Sostituisce tutti i dati dell'accantonamento e gli scenari dopo anteprima e conferma.</p><form method="post" asp-page-handler="Restore" enctype="multipart/form-data"><input asp-for="Version" type="hidden"/><label for="backup" class="field-label">Backup JSON (massimo 5 MB)</label><input name="Upload" id="backup" type="file" accept=".json" class="field mb-3" required/><button class="button">Verifica ripristino</button></form></section>
}
