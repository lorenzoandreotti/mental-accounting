@page
@model IndexModel
@using System.Globalization
@{ ViewData["Title"] = "Panoramica"; }
<div class="page-heading"><div><p class="eyebrow">IL TUO ACCANTONAMENTO</p><h1>Ogni euro, al suo posto.</h1><p class="muted mb-0">Situazione al @Model.Today.ToString("dd MMMM yyyy")</p></div><a asp-page="/Movements" class="button button-primary">Aggiungi movimento</a></div>
@if(Model.Result is not {} r){
<section class="panel"><h2>Inizia dal tuo saldo</h2><p>Imposta data iniziale, tasso, tassazione e calendario. Puoi poi recuperare i movimenti dal foglio Excel.</p><a asp-page="/Settings" class="button button-primary">Configura accantonamento</a></section>
}else{
<section class="grid gap-4 sm:grid-cols-2 mb-6" aria-label="Riepilogo">
<div class="panel bg-[var(--accent-soft)]"><span class="text-sm muted">Saldo disponibile</span><strong class="stat">@r.Balance.ToString("C")</strong><small>Comprende gli interessi netti già accreditati</small></div>
<div class="panel"><span class="text-sm muted">Interessi netti da accreditare</span><strong class="stat">@r.AccruedNet.ToString("C")</strong><small>Lordo @r.AccruedGross.ToString("C") · Imposta @r.AccruedTax.ToString("C")</small></div>
</section>
<section class="panel mb-5"><div class="flex flex-wrap justify-between gap-3"><h2>Movimenti</h2><a asp-page="/Movements" class="text-sm">Gestisci movimenti</a></div><p class="text-xs muted">Filtri e ordinamento riguardano tutto lo storico. I riepiloghi del saldo restano complessivi.</p>
<div data-grid data-sort="0:desc" aria-label="Movimenti della panoramica"><div class="table-scroll"><table class="data-table"><thead><tr><th data-type="date">Data</th><th data-type="select">Tipo</th><th data-type="text">Nota</th><th data-type="number">Importo (€)</th></tr></thead><tbody>
@foreach(var m in Model.State.Document.Ledger!.Movements){var signed=m.Kind==MentalAccounting.Domain.MovementKind.Deposit?m.Amount:-m.Amount;<tr><td data-value="@m.Date.ToString("yyyy-MM-dd")">@m.Date.ToString("dd/MM/yyyy")</td><td data-value="@m.Kind">@Labels.Movement(m.Kind)</td><td>@m.Note</td><td data-value="@signed.ToString(CultureInfo.InvariantCulture)">@signed.ToString("C")</td></tr>}
</tbody></table></div></div></section>
<section class="panel"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2>Interessi e obiettivi</h2><p class="muted text-sm mb-0">Già chiusi, in attesa di pagamento: @((r.PendingGross-r.PendingTax).ToString("C"))</p></div><div class="flex flex-wrap gap-2"><a asp-page="/Interest" class="button">Dettaglio interessi</a><a asp-page="/Simulations" class="button">Crea una simulazione</a></div></div></section>
}
