@page
@model IndexModel
@{ ViewData["Title"] = "Panoramica"; }
<div class="page-heading"><div><p class="eyebrow">IL TUO ACCANTONAMENTO</p><h1>Ogni euro, al suo posto.</h1><p class="text-secondary">Situazione al @Model.Today.ToString("dd MMMM yyyy")</p></div><a asp-page="/Movements" class="btn btn-primary">Aggiungi movimento</a></div>
@if(Model.Result is not {} r){
<section class="card card-body"><h2>Inizia dal tuo saldo</h2><p>Imposta data iniziale, tasso, tassazione e calendario. Puoi poi recuperare i movimenti dal foglio Excel.</p><a asp-page="/Settings" class="btn btn-primary align-self-start">Configura accantonamento</a></section>
}else{
<section class="row g-3 mb-4" aria-label="Riepilogo"><div class="col-md-6"><div class="card card-body balance-card"><span>Saldo disponibile</span><strong class="display-5">@r.Balance.ToString("C")</strong><small>Comprende gli interessi netti già accreditati</small></div></div>
<div class="col-md-6"><div class="card card-body"><span>Interessi netti da accreditare</span><strong class="display-5">@r.AccruedNet.ToString("C")</strong><small>Lordo @r.AccruedGross.ToString("C") · Imposta @r.AccruedTax.ToString("C")</small></div></div></section>
<div class="row g-4"><section class="col-lg-7"><div class="card card-body"><div class="section-heading"><h2>Ultimi movimenti</h2><a asp-page="/Movements">Vedi tutti</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Movimento</th><th class="text-end">Importo</th></tr></thead><tbody>
@foreach(var m in Model.State.Document.Ledger!.Movements.OrderByDescending(x=>x.Date).Take(8)){<tr><td>@m.Date.ToString("dd/MM/yyyy")</td><td>@Labels.Movement(m.Kind)<small class="d-block text-secondary">@m.Note</small></td><td class="text-end">@(m.Kind == MentalAccounting.Domain.MovementKind.Deposit ? "+" : "-")@m.Amount.ToString("C")</td></tr>}
@if(Model.State.Document.Ledger.Movements.Count==0){<tr><td colspan="3">Nessun movimento registrato.</td></tr>}
</tbody></table></div></div></section><section class="col-lg-5"><div class="card card-body"><h2>Interessi e obiettivi</h2><p>Consulta come matura il tuo accantonamento o prova un piano di versamenti.</p><a asp-page="/Interest" class="btn btn-outline-primary mb-2">Dettaglio interessi</a><a asp-page="/Simulations" class="btn btn-outline-primary">Crea una simulazione</a><p class="mt-3 mb-0 text-secondary">Già chiusi, in attesa di pagamento: @((r.PendingGross-r.PendingTax).ToString("C"))</p></div></section></div>
}
